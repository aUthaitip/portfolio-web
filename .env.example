# Copy to .env.local and enter the values from your existing Sanity project.
# NEXT_PUBLIC values are public configuration, not API tokens.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: server-only token for scripts/sync-resume.mjs --apply.
# SANITY_API_WRITE_TOKEN=
